# Copy to .env and fill in values

APP_NAME=guardian-OS
DEBUG=true
DATABASE_URL=your_postgres_url_here
GROQ_API_KEY=your_groq_key_here
JARVIS_ALLOW_OS=true
JARVIS_ALLOW_POWERSHELL=true
# Shell root — same as your CMD C:\WINDOWS\system32
JARVIS_POWERSHELL_ROOT=C:\Windows\System32
JARVIS_POWERSHELL_TIMEOUT=60
# Empty Recycle Bin can take minutes if it is very full (default 10 min)
JARVIS_RECYCLE_BIN_TIMEOUT=600
# How many recent voice commands Groq remembers per session (default 8)
JARVIS_MEMORY_TURNS=8
JARVIS_CONTEXT_TTL_SEC=600
# WhatsApp call button position (0-1 ratios inside window) — tweak if clicks miss
# JARVIS_WHATSAPP_AUDIO_CALL_X=0.84
# JARVIS_WHATSAPP_AUDIO_CALL_Y=0.10
# JARVIS_WHATSAPP_VIDEO_CALL_X=0.90
# JARVIS_WHATSAPP_VIDEO_CALL_Y=0.10
JARVIS_GROQ_REPLIES=true
# Speak plan immediately, then run task (frontend uses /jarvis/plan first)
JARVIS_EARLY_VOICE_ACK=true

# --- Vapi.ai (voice UI + TTS/STT) — https://dashboard.vapi.ai ---
# Public key: browser (@vapi-ai/web). Private key: server API (optional).
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# Optional: verify webhook POSTs from Vapi
VAPI_WEBHOOK_SECRET=
# Tool name must match Vapi assistant tool + backend default
VAPI_GUARDIAN_TOOL_NAME=run_guardian_command

# Optional ElevenLabs (not required — Vapi uses PlayHT by default)
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_API_KEY=
# Vapi web voice (no ElevenLabs): openai/alloy, or set to browser to skip voice patch
VAPI_VOICE_PROVIDER=openai
VAPI_VOICE_ID=alloy
VAPI_WEB_TRANSCRIBER_MODEL=nova-2
# ELEVENLABS_API_KEY=
